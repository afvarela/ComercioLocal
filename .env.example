# Copia este archivo como .env y completa los datos de tu proveedor de correo.
# Nunca compartas ni subas el archivo .env real.
POS_SMTP_HOST=smtp.example.com
POS_SMTP_PORT=587
POS_SMTP_SECURITY=starttls
POS_SMTP_USER=
POS_SMTP_PASSWORD=
POS_SMTP_FROM=ventas@example.com
POS_SMTP_FROM_NAME=Ferretería
